# ---------------------------------------------------------------------------
# Entry point
# ---------------------------------------------------------------------------


def _emit(stream, obj):
    if stream is None:  # the fd was closed (`>&-` / `2>&-`): python sets sys.stdout / sys.stderr to None
        return
    text = json.dumps(obj, indent=2, ensure_ascii=False) + '\n'
    try:
        stream.write(text)
    except UnicodeEncodeError:  # e.g. PYTHONIOENCODING=ascii — escaped JSON is still valid JSON
        stream.write(json.dumps(obj, indent=2, ensure_ascii=True) + '\n')
    stream.flush()


def _report(stderr, error):
    """Print a ClientError on stderr; a closed/broken stderr must not change the exit code."""
    try:
        _emit(stderr, error.payload())
    except (OSError, ValueError):
        pass
    return error.exit_code


def run(argv=None, env=None, cwd=None, stdout=None, stderr=None, script_path=None):
    """Run one command. Returns the exit code; never raises (except BrokenPipeError on stdout).

    Unexpected exceptions are reported as JSON too (exit 2) so the agent never has to parse a traceback.
    """
    argv = sys.argv[1:] if argv is None else argv
    stdout = sys.stdout if stdout is None else stdout
    stderr = sys.stderr if stderr is None else stderr
    try:
        try:
            args = build_parser(out=stdout).parse_args(argv)
        except _Exit as exc:  # --help / --version already printed
            return exc.code
        args.cwd = _getcwd() if cwd is None else cwd
        request = plan(args)
        root = find_root(getattr(args, 'root', None), env, script_path, args.cwd)
        client = Client(root, os.environ if env is None else env)
        if request.poll is not None:
            data = request_until_up(client, request)
        else:
            data = client.request(request.method, request.path, query=request.query, body=request.body,
                                  timeout=request.timeout)
        _emit(stdout, request.transform(data, client) if request.transform else data)
        return EXIT_OK
    except ClientError as exc:
        return _report(stderr, exc)
    except KeyboardInterrupt:
        return EXIT_INTERRUPTED
    except BrokenPipeError:
        raise  # stdout's reader went away; main() exits quietly
    except Exception as exc:  # a client bug: still answer in the documented JSON shape
        return _report(stderr, ClientError(
            EXIT_REQUEST, 'halugraph-client internal error: %s: %s' % (type(exc).__name__, exc),
            'This is a bug in tools/cmd/halugraph-client, not in your command. Tell the user and include this '
            'error.'))


def main():
    """Script entry point: run() with the real argv/streams, then exit with its code."""
    try:
        utf8_output([sys.stdout, sys.stderr], os.environ)
        interrupt_on_ctrl_break()
        code = run()
        if sys.stdout is not None:
            sys.stdout.flush()
    except KeyboardInterrupt:
        code = EXIT_INTERRUPTED
    except BrokenPipeError:
        # the reader of stdout went away (e.g. `| head`): exit quietly without a traceback
        try:
            devnull = os.open(os.devnull, os.O_WRONLY)
            os.dup2(devnull, sys.stdout.fileno())
        except (OSError, ValueError, AttributeError):
            pass
        code = EXIT_OK
    sys.exit(code)


if __name__ == '__main__':
    main()
