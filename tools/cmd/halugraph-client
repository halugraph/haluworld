def build_parser(out=None):
    """Build the argparse parser for all commands (spec §6.1). Help text goes to ``out`` (default stdout)."""
    common = _Parser(add_help=False)
    common.add_argument('--root', metavar='DIR', default=argparse.SUPPRESS,
                        help='project root (folder containing .hlg); default: auto-detect')

    parser = _Parser(prog=PROG, description=TOP_DESCRIPTION, epilog=TOP_EPILOG, formatter_class=_Formatter,
                     parents=[common], out=out)
    parser.add_argument('--version', action=_VersionAction, help="print the client's version and exit")
    sub = parser.add_subparsers(dest='command', metavar='COMMAND', title='commands')

    def add(container, name, summary, description, examples, aliases=()):
        epilog = 'examples:\n' + '\n'.join('  %s %s' % (PROG, e) for e in examples)
        return container.add_parser(name, help=summary, description=textwrap.fill(description, 100),
                                    epilog=epilog, formatter_class=_Formatter, parents=[common],
                                    aliases=list(aliases), out=out)

    def timeout_flag(p, what):
        p.add_argument('--timeout', type=seconds, default=DEFAULT_WAIT, metavar='S',
                       help='%s (default %d, at most %d)' % (what, DEFAULT_WAIT, MAX_WAIT))

    # -- agent loop --
