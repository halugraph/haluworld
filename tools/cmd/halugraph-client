def ping_result(data, client=None):
    """Summarize GET /api/project as ``{"ok": true, "url", "root", "via"}`` (+ ``"waited"`` after ``--wait``)."""
    data = data if isinstance(data, dict) else {}
    result = {'ok': True, 'url': data.get('url'), 'root': data.get('root'), 'via': client.via if client else None}
    waited = getattr(client, 'waited', None)
    if waited is not None:
        result['waited'] = waited
    return result


def plan_ping(args):
    return Plan('GET', '/api/project', transform=ping_result, poll=getattr(args, 'wait', None))


def request_until_up(client, plan, clock=None, sleep=None):
    """Send ``plan`` until halugraph answers or ``plan.poll`` seconds pass (``ping --wait``).

    "Not running" (exit 3) and request timeouts mean "not up yet": the request is retried after a pause
    that starts at POLL_FIRST and doubles up to POLL_MAX, never sleeping past the deadline. Each attempt's
    socket timeout is the time left (at least POLL_MIN_TIMEOUT, at most the plan's timeout). Any other
    failure — an HTTP error is an answer — is raised at once. When the time is up, raises exit 3 naming the
    last reason. On success ``client.waited`` holds the seconds spent (one decimal).
    """
    clock = clock or time.monotonic
    sleep = sleep or time.sleep
    started = clock()
    deadline = started + plan.poll
    pause = POLL_FIRST
    while True:
        left = deadline - clock()
        timeout = min(plan.timeout, max(left, POLL_MIN_TIMEOUT))
        try:
            data = client.request(plan.method, plan.path, query=plan.query, body=plan.body, timeout=timeout)
        except ClientError as exc:
            if exc.exit_code != EXIT_NOT_RUNNING and not isinstance(exc, RequestTimeout):
                raise
            last = exc
        else:
            client.waited = _number(round(clock() - started, 1))
            return data
        left = deadline - clock()
        if left <= 0:
            raise ClientError(EXIT_NOT_RUNNING, 'halugraph did not answer within %s s (%s)'
                              % (_number(plan.poll), last.error), not_running_hint(client.root))
        sleep(min(pause, left))
        pause = min(pause * 2, POLL_MAX)


SUBCOMMANDS = {'errors': ('list', 'clear'), 'compile': ('start', 'progress', 'done', 'list')}


def plan(args):
    """Turn parsed arguments into a Plan (raises an exit-code-1 ClientError for invalid combinations)."""
    if not hasattr(args, 'cwd'):
        args.cwd = _getcwd()
    build = getattr(args, 'plan', None)
    if build is None:
        # No parent parser sets a `plan` default on purpose: subparser defaults must not compete with
        # parent defaults (their precedence changed in Python 3.9.8 / 3.10.0).
        command = getattr(args, 'command', None)
        if command in SUBCOMMANDS:
            raise usage_error('%s needs a subcommand: %s' % (command, ' | '.join(SUBCOMMANDS[command])),
                              'Run `%s %s --help`.' % (PROG, command))
        raise usage_error('missing COMMAND', 'Start with `%s hello`, then `%s wait`. Run `%s --help` for all '
                          'commands.' % (PROG, PROG, PROG))
    return build(args)


