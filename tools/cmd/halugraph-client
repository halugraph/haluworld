#!/bin/sh
"""": # halugraph-client: the lines up to the closing quotes are its sh launcher (python reads them as a string)
# Picks a working python >= 3.8 and runs this same file with it: $HALUGRAPH_PYTHON when set, else the first
# of python3, python, py -3 that answers the probe (which skips the Microsoft Store stubs that Windows puts
# on the PATH as python3 / python; -S keeps it cheap). For a Windows python (Git Bash, where Claude Code runs commands on
# Windows) it converts $0, --root, --file and $HALUGRAPH_ROOT to Windows paths with cygpath and turns MSYS's
# own argument conversion off, which would turn text such as "/preview/latest" into a Windows path.
hlg_probe() {
  hlg_out=$("$@" -S -c 'import sys; sys.version_info[:2] >= (3, 8) and print("halugraph-python " + sys.platform)' </dev/null 2>/dev/null) || return 1
  case $hlg_out in "halugraph-python "*) hlg_platform=${hlg_out#halugraph-python }; return 0;; esac
  return 1
}
hlg_arg=
if [ -n "${HALUGRAPH_PYTHON:-}" ]; then
  hlg_py=$HALUGRAPH_PYTHON
  hlg_probe "$hlg_py" || {
    echo '{"error": "HALUGRAPH_PYTHON is set but does not run python 3.8 or newer", "hint": "Point HALUGRAPH_PYTHON at a python 3.8+ executable, or unset it to search python3, python and py -3."}' >&2
    exit 127
  }
elif hlg_probe python3; then hlg_py=python3
elif hlg_probe python; then hlg_py=python
elif hlg_probe py -3; then hlg_py=py hlg_arg=-3
else
  echo '{"error": "no python 3.8 or newer found (tried python3, python and py -3)", "hint": "Ask the user to install Python 3.8+ (python.org; on Windows tick Add python.exe to PATH), or to set HALUGRAPH_PYTHON to a python executable."}' >&2
  exit 127
fi
hlg_self=$0
case $hlg_platform in
  win32*)
    if command -v cygpath >/dev/null 2>&1; then
      hlg_win() { cygpath -w -- "$1"; }
      case $hlg_self in /*) hlg_self=$(hlg_win "$hlg_self");; esac
      case ${HALUGRAPH_ROOT:-} in /*) HALUGRAPH_ROOT=$(hlg_win "$HALUGRAPH_ROOT"); export HALUGRAPH_ROOT;; esac
      hlg_n=$#
      hlg_prev=
      for hlg_a in "$@"; do
        case $hlg_prev in --root|--file) case $hlg_a in /*) hlg_a=$(hlg_win "$hlg_a");; esac;; esac
        case $hlg_a in
          --root=/*) hlg_a=--root=$(hlg_win "${hlg_a#--root=}");;
          --file=/*) hlg_a=--file=$(hlg_win "${hlg_a#--file=}");;
        esac
        set -- "$@" "$hlg_a"
        hlg_prev=$hlg_a
      done
      shift "$hlg_n"
      MSYS_NO_PATHCONV=1
      MSYS2_ARG_CONV_EXCL='*'
      export MSYS_NO_PATHCONV MSYS2_ARG_CONV_EXCL
    fi;;
esac
exec "$hlg_py" $hlg_arg "$hlg_self" "$@"
"""
"""halugraph-client — the AI agent's bridge to the running halugraph server of this project.

Full reference: tools/doc/halugraph-client.md. Python >= 3.8, standard library only, one file.

The client finds the project root (``--root``, ``$HALUGRAPH_ROOT``, its own location
``tools/cmd/../..``, or the nearest parent of the cwd that contains ``.hlg``), connects to the server
over the unix socket (``util/halugraph.sock`` or the path in ``util/instance.json``) and falls back to
TCP (``url`` in ``util/instance.json``); on Windows it always uses TCP. Results are printed as pretty
UTF-8 JSON on stdout; failures as JSON ``{"error", "hint"}`` on stderr with exit code 1 (usage),
2 (request failed), 3 (halugraph not running) or 130 (interrupted: Ctrl+C, or Ctrl+Break on Windows).
The sh lines above this docstring make the file its own launcher (spec §10): ``tools/cmd/halugraph-client``
works in sh / bash / Git Bash, ``tools/cmd/halugraph-client.cmd`` in cmd.exe / PowerShell.
"""
import argparse
import http.client
import json
import math
import os
import re
import shlex
import signal
import socket
import stat
import sys
import textwrap
import threading
import time
from urllib.parse import quote, urlencode, urlsplit

CLIENT_VERSION = '0.1.0'
PROG = 'tools/cmd/halugraph-client'
DOC_PATH = 'tools/doc/halugraph-client.md'

EXIT_OK = 0
EXIT_USAGE = 1
EXIT_REQUEST = 2
EXIT_NOT_RUNNING = 3
EXIT_INTERRUPTED = 130

DEFAULT_TIMEOUT = 30      # socket timeout (s) for ordinary requests
DEFAULT_WAIT = 540        # default long-poll (s) for wait / ask / dialog / dialog-wait
MAX_WAIT = 3600           # the server clamps long-polls to this; so does the client (keeps timeouts sane)
MAX_BODY = 10 * 1024 * 1024  # the server rejects larger request bodies (413)
MAX_INSTANCE_BYTES = 1024 * 1024  # util/instance.json: halugraph writes a few hundred bytes
TIMEOUT_MARGIN = 30       # long-poll socket timeout = requested seconds + this margin
POLL_FIRST = 0.2          # ping --wait: first pause between attempts (s); doubles up to POLL_MAX
POLL_MAX = 1.0
POLL_MIN_TIMEOUT = 1.0    # ping --wait: an attempt's socket timeout never drops below this (s)
INTERRUPTIBLE_REQUESTS = sys.platform == 'win32'  # run requests in a worker thread (see interruptible())
INTERRUPT_SLICE = 0.1     # the main thread's wait slice while a request runs in the worker (s)

AGENT_HEADER = 'x-halugraph-client'
AGENT_VALUE = 'agent'
MARKER = '.hlg'
DEFAULT_ASK_TITLE = 'Question from the agent'
PENDING_HINT = "the answer will arrive via wait as an 'answer' event"

LEVELS = ('info', 'success', 'warning', 'error')
STATES = ('idle', 'busy', 'done', 'error')
SEVERITIES = ('error', 'warning', 'info')
LOG_LEVELS = ('debug', 'info', 'warning', 'error')
SIDES = ('input', 'output')


# ---------------------------------------------------------------------------
# Errors
# ---------------------------------------------------------------------------


class ClientError(Exception):
    """A failure that ends the command with ``exit_code`` and prints ``{"error", "hint"}`` on stderr."""

    def __init__(self, exit_code, error, hint=None, status=None):
        Exception.__init__(self, error)
        self.exit_code = exit_code
        self.error = error
        self.hint = hint or ''
        self.status = status

    def payload(self):
        """The JSON object printed on stderr."""
        data = {'error': self.error, 'hint': self.hint}
        if self.status is not None:
            data['status'] = self.status
        return data


class RequestTimeout(ClientError):
    """The server accepted the connection but did not answer in time (exit 2; ``ping --wait`` retries)."""


def usage_error(message, hint=None):
    """Build an exit-code-1 error (bad command line, unreadable input file, no project found)."""
    return ClientError(EXIT_USAGE, message, hint or 'Run `%s --help` or read %s.' % (PROG, DOC_PATH))


_SAFE_WINDOWS_WORD = re.compile(r'^[A-Za-z0-9_.,:=@+\\/-]+$')


def shell_quote(text, platform=sys.platform):
    """Quote ``text`` for the user's shell: POSIX quoting, or on Windows "…" (read the same way by cmd.exe,
    PowerShell and Git Bash for a Windows path, which cannot contain a double quote)."""
    if platform != 'win32':
        return shlex.quote(text)
    return text if _SAFE_WINDOWS_WORD.match(text) else '"%s"' % text


def not_running_hint(root):
    """The standard hint when the server for ``root`` cannot be reached."""
    return 'halugraph is not running for %s. Ask the user to start it: halugraph %s' % (root, shell_quote(root))


def not_running(root, message):
    """Build an exit-code-3 error."""
    return ClientError(EXIT_NOT_RUNNING, message, not_running_hint(root))


def in_network_sandbox(env):
    """True inside Codex's sandbox without network (it sets CODEX_SANDBOX_NETWORK_DISABLED=1)."""
    return env.get('CODEX_SANDBOX_NETWORK_DISABLED') == '1'


SANDBOX_HINT = ('Codex ran this command inside its sandbox, which blocks connections to halugraph on this computer. '
                '.codex/rules/halugraph.rules lets this client out of the sandbox, but Codex loads it only for a '
                'trusted project folder: ask the user to quit Codex, start it again in the project folder and answer '
                'its "trust this folder" question with yes. halugraph cannot be reached until then, so do not wait for '
                'it with ping --wait.')


def sandboxed(error):
    """An exit-3 conclusion made inside the sandbox (a pid from another PID namespace looks dead, connections
    are refused) says nothing about halugraph: report the sandbox instead (exit 2)."""
    return ClientError(EXIT_REQUEST, 'cannot reach halugraph from inside the Codex sandbox (%s)' % error.error,
                       SANDBOX_HINT)


def _status_hint(status):
    if status == 400:
        return 'halugraph rejected the request; check the arguments (see %s).' % DOC_PATH
    if status == 404:
        return 'Not found: check the name or id (list them with: graphs, nodes, compile list, events).'
    if status == 409:
        return 'Conflict: the target is not in a state that allows this (e.g. the dialog is no longer open).'
    if status == 413:
        return 'The request is too large (the server accepts at most 10 MB).'
    if status == 415:
        return 'Requests must be JSON. This is a halugraph-client bug; tell the user.'
    if status >= 500:
        return 'halugraph failed internally. Tell the user and include this error.'
    return 'See %s.' % DOC_PATH


# ---------------------------------------------------------------------------
# Project root discovery
# ---------------------------------------------------------------------------


def _has_marker(path):
    return os.path.isfile(os.path.join(path, MARKER))


_MSYS_DRIVE = re.compile(r'^/(?:cygdrive/)?([A-Za-z])(?=/|$)')


def native_path(path, platform=sys.platform):
    """On Windows, an MSYS / Cygwin drive path (``/c/Users/me``, ``/cygdrive/c/x``) — what Git Bash users
    type — becomes ``C:\\Users\\me``. Anything else, and every path on other platforms, is unchanged."""
    match = _MSYS_DRIVE.match(path) if platform == 'win32' else None
    if match is None:
        return path
    return match.group(1).upper() + ':\\' + path[match.end():].lstrip('/').replace('/', '\\')


def _explicit_root(path, source, cwd):
    root = os.path.normpath(os.path.join(cwd, os.path.expanduser(native_path(path))))
    if not os.path.isdir(root):
        raise usage_error('%s points to a folder that does not exist: %s' % (source, root),
                          'Pass the halugraph project root (the folder that contains .hlg).')
    if not _has_marker(root):
        raise usage_error('%s is not a halugraph project (no .hlg file in %s)' % (source, root),
                          'Pass the project root itself (the folder that contains .hlg), not a subfolder.')
    return root


def _script_roots(script_path):
    roots = []
    for resolved in (os.path.abspath(script_path), os.path.realpath(script_path)):
        root = os.path.dirname(os.path.dirname(os.path.dirname(resolved)))  # tools/cmd/<script> → root
        if root not in roots:
            roots.append(root)
    return roots


def find_root(explicit=None, env=None, script_path=None, cwd=None):
    """Return the absolute project root.

    Order: ``explicit`` (--root), ``env['HALUGRAPH_ROOT']``, the script's own location
    (``tools/cmd/../..`` when it contains ``.hlg``), then the cwd and its parents. Raises an
    exit-code-1 ClientError when nothing is found or an explicit root is not a project.
    """
    env = os.environ if env is None else env
    cwd = _getcwd() if cwd is None else cwd
    if explicit:
        return _explicit_root(explicit, '--root', cwd)
    if env.get('HALUGRAPH_ROOT'):
        return _explicit_root(env['HALUGRAPH_ROOT'], 'HALUGRAPH_ROOT', cwd)
    for root in _script_roots(script_path or __file__):
        if _has_marker(root):
            return root
    current = os.path.normpath(os.path.join(os.sep, cwd))
    while True:
        if _has_marker(current):
            return current
        parent = os.path.dirname(current)
        if parent == current:
            break
        current = parent
    raise usage_error('no halugraph project found (no .hlg file in %s or any parent folder)' % cwd,
                      'Run this from inside the project folder, pass --root <project>, or set HALUGRAPH_ROOT. '
                      'A new project is created by the user with: halugraph <folder>')


def _getcwd():
    try:
        return os.getcwd()
    except OSError:  # the cwd was deleted
        return os.sep


# ---------------------------------------------------------------------------
# Connecting
# ---------------------------------------------------------------------------


def read_instance(root):
    """Return the parsed ``util/instance.json`` of ``root`` or None (missing / unreadable / not an object).

    Only a regular file of a sane size is read: a FIFO would block the read forever and a link to an endless
    device (``/dev/zero``) would never end it."""
    path = os.path.join(root, 'util', 'instance.json')
    try:
        info = os.stat(path)
        if not stat.S_ISREG(info.st_mode) or info.st_size > MAX_INSTANCE_BYTES:
            return None
        with open(path, encoding='utf-8') as f:
            data = json.load(f)
    except (OSError, ValueError):
        return None
    return data if isinstance(data, dict) else None


def instance_matches(root, instance):
    """True when instance.json was written for this project root (spec §5.2 always includes ``root``).

    A project folder copied while halugraph runs carries the original's instance.json; following it would
    connect the agent to the ORIGINAL project's server. ``samefile`` tolerates symlinks and case-insensitive
    filesystems.
    """
    other = instance.get('root') if isinstance(instance, dict) else None
    if not isinstance(other, str) or not other:
        return False
    try:
        return os.path.samefile(root, other)
    except (OSError, ValueError):
        return False


def _distrust_reason(instance):
    other = instance.get('root')
    if isinstance(other, str) and other:
        return ('util/instance.json belongs to another project (%s); this folder was probably copied while '
                'halugraph was running' % other)
    return 'util/instance.json has no "root", so it was not written by halugraph'


def is_local_address(host):
    """True when ``host`` is this machine: ``localhost``, a loopback address or an address of a local
    interface (probed by binding to it). The TCP fallback never connects anywhere else, so an
    instance.json committed into a cloned project cannot route the agent to a remote server."""
    if host == 'localhost':
        return True
    if not host:
        return False
    try:
        infos = socket.getaddrinfo(host, None, 0, socket.SOCK_STREAM)
    except (OSError, UnicodeError, ValueError):
        return False
    for family, _, _, _, address in infos:
        try:
            probe = socket.socket(family, socket.SOCK_STREAM)
        except OSError:
            continue
        try:
            probe.bind((address[0], 0) + tuple(address[2:]))
            return True
        except OSError:
            continue
        finally:
            probe.close()
    return False


def unix_sockets_available(platform=sys.platform):
    """Whether to try unix sockets at all. Never on Windows (spec §10: halugraph listens on a named pipe
    there, and CPython's AF_UNIX support on Windows is missing or unreliable), nor without AF_UNIX."""
    return platform != 'win32' and hasattr(socket, 'AF_UNIX')


_NAMED_PIPE = re.compile(r'^[\\/][\\/][.?][\\/]pipe[\\/]', re.I)


def socket_candidates(root, instance):
    """Unix socket paths to try, in order: instance.json ``socket``, then ``util/halugraph.sock``. A Windows
    named pipe (``\\\\.\\pipe\\…``, what halugraph records there) is not a unix socket and is skipped."""
    paths = []
    sock = instance.get('socket') if isinstance(instance, dict) else None
    if isinstance(sock, str) and sock and not _NAMED_PIPE.match(sock):
        paths.append(os.path.join(root, sock))
    default = os.path.join(root, 'util', 'halugraph.sock')
    if default not in paths:
        paths.append(default)
    return paths


def tcp_target(instance):
    """Return ``(host, port)`` from instance.json (``url``, else ``host`` + ``port``) or None."""
    if not isinstance(instance, dict):
        return None
    host, port = None, None
    url = instance.get('url')
    if isinstance(url, str) and url:
        try:
            parts = urlsplit(url)
            if parts.scheme == 'http' and parts.hostname:
                host, port = parts.hostname, parts.port or 80
        except ValueError:
            host, port = None, None
    if host is None:
        h, p = instance.get('host'), instance.get('port')
        if isinstance(h, str) and h and isinstance(p, int) and not isinstance(p, bool):
            host, port = h, p
    if host is None or not (0 < port < 65536):
        return None
    if host in ('0.0.0.0', '::'):
        host = '127.0.0.1'
    return host, port


def pid_is_dead(pid):
    """True when ``pid`` names a process of this machine that no longer exists. Anything uncertain (no
    permission, a nonsense pid, an unknown platform) counts as alive, so the client just tries to connect."""
    if not isinstance(pid, int) or isinstance(pid, bool) or not 0 < pid < 2 ** 32:
        return False
    if os.name == 'nt':
        return _windows_pid_is_dead(pid)
    if os.name != 'posix':
        return False
    try:
        os.kill(pid, 0)
    except ProcessLookupError:
        return True
    except (OSError, OverflowError, ValueError):
        return False
    return False


def _windows_pid_is_dead(pid):
    """OpenProcess + GetExitCodeProcess (os.kill(pid, 0) would TERMINATE the process on Windows)."""
    try:
        import ctypes
        from ctypes import wintypes
        kernel32 = ctypes.WinDLL('kernel32', use_last_error=True)
        kernel32.OpenProcess.restype = wintypes.HANDLE
        kernel32.OpenProcess.argtypes = (wintypes.DWORD, wintypes.BOOL, wintypes.DWORD)
        kernel32.GetExitCodeProcess.argtypes = (wintypes.HANDLE, ctypes.POINTER(wintypes.DWORD))
        kernel32.CloseHandle.argtypes = (wintypes.HANDLE,)
        handle = kernel32.OpenProcess(0x1000, False, pid)  # PROCESS_QUERY_LIMITED_INFORMATION
        if not handle:
            return ctypes.get_last_error() == 87  # ERROR_INVALID_PARAMETER: no process has this id
        try:
            code = wintypes.DWORD()
            if not kernel32.GetExitCodeProcess(handle, ctypes.byref(code)):
                return False
            return code.value != 259  # STILL_ACTIVE; an exited process lingers while someone holds a handle
        finally:
            kernel32.CloseHandle(handle)
    except (ImportError, AttributeError, OSError, ValueError):
        return False


def _pid_is_dead(instance):
    """True when instance.json names a local process that no longer exists (a stale file)."""
    return pid_is_dead(instance.get('pid'))


class UnixHTTPConnection(http.client.HTTPConnection):
    """HTTP over a unix domain socket (the server's ``util/halugraph.sock``)."""

    def __init__(self, path, timeout=DEFAULT_TIMEOUT):
        http.client.HTTPConnection.__init__(self, 'localhost', timeout=timeout)
        self.socket_path = path

    def connect(self):
        sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        try:
            sock.settimeout(self.timeout)
            sock.connect(self.socket_path)
        except BaseException:
            sock.close()
            raise
        self.sock = sock


TCPConnection = http.client.HTTPConnection


def wire_text(value):
    """Make ``value`` encodable as UTF-8 for the request.

    Command-line bytes that are not UTF-8 reach python as surrogate escapes (``'\\udcff'``); they become
    U+FFFD instead of crashing the JSON / URL encoding. File paths keep their surrogates (the OS needs them).
    """
    try:
        value.encode('utf-8')
        return value
    except UnicodeEncodeError:
        try:
            return value.encode('utf-8', 'surrogateescape').decode('utf-8', 'replace')
        except UnicodeEncodeError:  # a lone surrogate that is not an escaped byte
            return ''.join('\ufffd' if 0xD800 <= ord(c) <= 0xDFFF else c for c in value)


def _encode_query(query):
    pairs = [(k, wire_text(v) if isinstance(v, str) else _number(v)) for k, v in query.items() if v is not None]
    return urlencode(pairs, quote_via=quote, safe='/')


def _segment(value):
    return quote(wire_text(value), safe='')


def _json_bytes(body):
    return wire_text(json.dumps(body, ensure_ascii=False)).encode('utf-8')


def _snippet(text, limit=300):
    text = ' '.join(text.split())
    return text if len(text) <= limit else text[:limit] + '…'


class Client(object):
    """Talks to the halugraph server of one project. ``via`` is 'unix' or 'tcp' after a request."""

    def __init__(self, root, env=None):
        self.root = root
        self.via = None
        self.env = os.environ if env is None else env

    def _connect(self, timeout):
        try:
            return self._open(timeout)
        except ClientError as exc:
            if exc.exit_code == EXIT_NOT_RUNNING and in_network_sandbox(self.env):
                raise sandboxed(exc)
            raise

    def _open(self, timeout):
        instance = read_instance(self.root)
        distrust = None
        if instance is not None and not instance_matches(self.root, instance):
            distrust, instance = _distrust_reason(instance), None
        for path in socket_candidates(self.root, instance) if unix_sockets_available() else []:
            if not os.path.exists(path):
                continue
            conn = UnixHTTPConnection(path, timeout=timeout)
            try:
                conn.connect()
            except OSError:
                conn.close()
                continue  # stale socket file → try the next one / TCP
            self.via = 'unix'
            return conn
        if distrust is not None:
            raise not_running(self.root, 'cannot reach halugraph: ' + distrust)
        if instance is None:
            state = 'unreadable' if os.path.exists(os.path.join(self.root, 'util', 'instance.json')) else 'missing'
            raise not_running(self.root, 'cannot reach halugraph: no live socket and util/instance.json is %s' % state)
        target = tcp_target(instance)
        if target is None:
            raise not_running(self.root, 'cannot reach halugraph: util/instance.json has no usable url/host/port')
        if _pid_is_dead(instance):
            raise not_running(self.root, 'util/instance.json is stale: halugraph process %s is gone'
                              % instance.get('pid'))
        if not is_local_address(target[0]):
            raise not_running(self.root, 'cannot reach halugraph: util/instance.json points to %s, which is not '
                              'an address of this machine' % target[0])
        conn = TCPConnection(target[0], target[1], timeout=timeout)
        try:
            conn.connect()
        except OSError as exc:
            conn.close()
            raise not_running(self.root, 'cannot connect to halugraph at %s:%s (%s)'
                              % (target[0], target[1], getattr(exc, 'strerror', None) or exc))
        self.via = 'tcp'
        return conn

    def request(self, method, path, query=None, body=None, timeout=DEFAULT_TIMEOUT):
        """Send one request and return the decoded JSON (``{"ok": true}`` for an empty 2xx body).

        Raises ClientError: exit 1 for a body over the server's 10 MB limit (checked before connecting),
        exit 2 for HTTP errors / timeouts / bad JSON, exit 3 when unreachable. KeyboardInterrupt (Ctrl+C)
        arrives at once on every platform (see interruptible()).
        """
        return interruptible(lambda: self._request(method, path, query, body, timeout))

    def _request(self, method, path, query, body, timeout):
        url = path + ('?' + _encode_query(query) if query else '')
        headers = {AGENT_HEADER: AGENT_VALUE, 'Accept': 'application/json',
                   'User-Agent': 'halugraph-client/' + CLIENT_VERSION}
        data = None
        if method in ('POST', 'PUT', 'PATCH', 'DELETE'):
            data = b'' if body is None else _json_bytes(body)
            headers['Content-Type'] = 'application/json'
            headers['Content-Length'] = str(len(data))
            if len(data) > MAX_BODY:
                raise usage_error('the request is %.1f MB; halugraph accepts at most 10 MB' % (len(data) / 1048576.0),
                                  'Shorten the text (e.g. show a summary in the dialog and keep details in a file).')
        conn = self._connect(timeout)
        try:
            conn.request(method, url, body=data or None, headers=headers)
            response = conn.getresponse()
            status, raw = response.status, response.read()
        except socket.timeout:
            raise RequestTimeout(EXIT_REQUEST, 'request timed out after %s s (%s %s)' % (_number(timeout), method, path),
                                 'halugraph did not answer in time. Retry; if it keeps happening ask the user '
                                 'whether halugraph is still running.')
        except (http.client.RemoteDisconnected, ConnectionError, http.client.IncompleteRead):
            raise not_running(self.root, 'the connection to halugraph was closed before it answered (%s %s)'
                              % (method, path))
        except (http.client.HTTPException, OSError) as exc:
            raise ClientError(EXIT_REQUEST, 'request failed (%s %s): %s' % (method, path, exc),
                              'Retry once; if it fails again tell the user.')
        finally:
            conn.close()
        return _decode_response(status, raw)


def interruptible(call, enabled=None):
    """Return ``call()``. With ``enabled`` (default INTERRUPTIBLE_REQUESTS, i.e. on Windows) it runs in a
    daemon worker thread while the main thread waits in short slices: Windows delivers Ctrl+C to a thread
    blocked in recv() only when recv returns — up to 570 s into a ``wait`` — but to a waiting main thread
    within a slice. The call's exception (or result) is passed on unchanged."""
    if not (INTERRUPTIBLE_REQUESTS if enabled is None else enabled):
        return call()
    box = {}

    def work():
        try:
            box['result'] = call()
        except BaseException as exc:  # handed to the main thread below
            box['error'] = exc

    worker = threading.Thread(target=work, name='halugraph-client request')
    worker.daemon = True  # an interrupted request must not keep the process alive
    worker.start()
    while worker.is_alive():
        worker.join(INTERRUPT_SLICE)
    if 'error' in box:
        raise box['error']
    return box.get('result')


def _raise_interrupt(signum, frame):
    raise KeyboardInterrupt()


def interrupt_on_ctrl_break(signal_module=signal, platform=sys.platform):
    """On Windows, Ctrl+Break (SIGBREAK — also what a parent sends a console process group) ends the client
    like Ctrl+C: exit 130, quietly. By default Windows would kill it with STATUS_CONTROL_C_EXIT."""
    sigbreak = getattr(signal_module, 'SIGBREAK', None)
    if platform == 'win32' and sigbreak is not None:
        signal_module.signal(sigbreak, _raise_interrupt)


def utf8_output(streams, env):
    """Switch text streams to UTF-8 (keeping their error handler) unless PYTHONIOENCODING chose an encoding:
    a Windows console / pipe defaults to the ANSI code page (cp1252 …), which would write "é" as a byte the
    agent's UTF-8 reader cannot decode. Streams that are closed, already UTF-8 or not reconfigurable are
    left alone."""
    if env.get('PYTHONIOENCODING'):
        return
    for stream in streams:
        encoding = getattr(stream, 'encoding', None) if stream is not None else None
        if not encoding or encoding.lower().replace('_', '-') in ('utf-8', 'utf8'):
            continue
        try:
            stream.reconfigure(encoding='utf-8')
        except (AttributeError, ValueError, OSError, LookupError):
            pass


_INVALID = object()


def _decode_response(status, raw):
    text = raw.decode('utf-8', 'replace')
    data = None
    if text.strip():
        try:
            data = json.loads(text)
        except ValueError:
            data = _INVALID
    if 200 <= status < 300:
        if data is None:
            return {'ok': True}
        if data is _INVALID:
            raise ClientError(EXIT_REQUEST, 'halugraph returned invalid JSON (HTTP %d): %s' % (status, _snippet(text)),
                              'This is unexpected; tell the user.', status=status)
        return data
    error = hint = None
    if isinstance(data, dict):
        error = data.get('error') if isinstance(data.get('error'), str) else None
        hint = data.get('hint') if isinstance(data.get('hint'), str) else None
    if not error:
        error = 'HTTP %d %s: %s' % (status, http.client.responses.get(status, ''), _snippet(text) or '(empty body)')
    raise ClientError(EXIT_REQUEST, error, hint or _status_hint(status), status=status)


# ---------------------------------------------------------------------------
# Argument types
# ---------------------------------------------------------------------------


def _number(value):
    """Integral floats become ints so JSON bodies read ``540`` instead of ``540.0``."""
    return int(value) if isinstance(value, float) and value.is_integer() else value


def _finite(text):
    try:
        value = float(text)
    except (TypeError, ValueError):
        return None
    return value if math.isfinite(value) else None


def seconds(text):
    """argparse type: a finite number of seconds >= 0, capped at MAX_WAIT (the server's own cap)."""
    value = _finite(text)
    if value is None or value < 0:
        raise argparse.ArgumentTypeError('expected seconds >= 0, got %r' % text)
    return _number(min(value, MAX_WAIT))


def fraction(text):
    """argparse type: progress as a fraction 0..1."""
    value = _finite(text)
    if value is None or not 0 <= value <= 1:
        raise argparse.ArgumentTypeError('expected a fraction between 0 and 1 (e.g. 0.5), got %r' % text)
    return _number(value)


def line_number(text):
    """argparse type: a 1-based line number."""
    try:
        value = int(text)
    except (TypeError, ValueError):
        value = 0
    if value < 1:
        raise argparse.ArgumentTypeError('expected a line number >= 1, got %r' % text)
    return value


# ---------------------------------------------------------------------------
# Commands → requests
#
# One ``plan_<command>(args) -> Plan`` per (sub)command, wired up in build_parser() with
# ``set_defaults(plan=…)``. Plans validate their arguments (usage errors, exit 1) and never do I/O except
# reading ``dialog --file``; run() sends the Plan and prints the (optionally transformed) result.
# ---------------------------------------------------------------------------


class Plan(object):
    """One HTTP request derived from the command line, plus an optional result transform.

    ``poll`` (seconds, ``ping --wait``) retries the request until halugraph answers or the time is up.
    """

    def __init__(self, method, path, query=None, body=None, timeout=DEFAULT_TIMEOUT, transform=None, poll=None):
        self.method = method
        self.path = path
        self.query = query
        self.body = body
        self.timeout = timeout
        self.transform = transform
        self.poll = poll

    def __repr__(self):
        return 'Plan(%s %s %r %r timeout=%r poll=%r)' % (self.method, self.path, self.query, self.body, self.timeout,
                                                         self.poll)


def _long_poll(wait_seconds):
    return wait_seconds + TIMEOUT_MARGIN


def _words(words, name):
    text = ' '.join(words or [])
    if not text.strip():
        raise usage_error('%s must not be empty' % name)
    return text


def _required(value, name):
    if value is None or not value.strip():
        raise usage_error('%s must not be empty' % name)
    return value


def _labels(values, flag):
    return [_required(v, flag) for v in values]


def _optional(body, key, value):
    if value is not None:
        body[key] = value
    return body


def _read_markdown(path, cwd):
    if path != '-':
        path = native_path(path)
    if path == '-':
        try:
            stream = getattr(sys.stdin, 'buffer', sys.stdin)
            raw = stream.read()
        except (AttributeError, OSError, ValueError):  # stdin closed (`<&-`) or unreadable
            raise usage_error('cannot read --file - : stdin is closed or unreadable',
                              'Pipe the markdown into the client, or pass --file <path> / --markdown <text>.')
    else:
        full = os.path.join(cwd, os.path.expanduser(path))
        try:
            with open(full, 'rb') as f:
                raw = f.read()
        except OSError as exc:
            raise usage_error('cannot read --file %s: %s' % (path, exc.strerror or exc),
                              'Pass an existing markdown file (paths are relative to the current folder).')
    if isinstance(raw, str):
        return raw
    try:
        return raw.decode('utf-8-sig')
    except UnicodeDecodeError:
        raise usage_error('--file %s is not UTF-8 text' % path, 'Save the markdown file as UTF-8.')


def plan_hello(args):
    return Plan('POST', '/api/agent/hello', body=_optional({}, 'name', args.name))


def plan_wait(args):
    return Plan('POST', '/api/agent/wait', body={'timeout': args.timeout}, timeout=_long_poll(args.timeout))


def ask_result(data, client=None):
    """Map a DialogResponse to ``{"status": "answered"|"pending"|"cancelled", ...}``."""
    dialog = data.get('dialog') if isinstance(data, dict) else None
    if not isinstance(dialog, dict):
        raise ClientError(EXIT_REQUEST,
                          'unexpected response from halugraph (no dialog): %s' % _snippet(json.dumps(data)),
                          'This is unexpected; tell the user.')
    state, dialog_id = dialog.get('state'), dialog.get('id')
    if state == 'answered':
        answer = dialog.get('answer') if isinstance(dialog.get('answer'), dict) else {}
        return {'status': 'answered', 'action': answer.get('action'), 'text': answer.get('text'), 'dialogId': dialog_id}
    if state == 'cancelled':
        return {'status': 'cancelled', 'dialogId': dialog_id}
    return {'status': 'pending', 'dialogId': dialog_id, 'hint': PENDING_HINT}


def plan_ask(args):
    question = _words(args.question, 'QUESTION')
    choices = _labels(args.choice or [], '--choice')
    if choices:
        actions, with_input = choices, bool(args.input)
    else:
        with_input = args.input is not False
        actions = ['Submit'] if with_input else ['OK']
    title = args.title if args.title and args.title.strip() else DEFAULT_ASK_TITLE
    body = {'title': title, 'markdown': question, 'actions': actions, 'input': {} if with_input else None,
            'wait': args.timeout}
    return Plan('POST', '/api/dialogs', body=body, timeout=_long_poll(args.timeout), transform=ask_result)


def plan_dialog(args):
    title = _required(args.title, '--title')
    markdown = args.markdown if args.markdown is not None else _read_markdown(args.file, args.cwd)
    actions = _labels(args.action, '--action') if args.action else ['OK']
    wait = 0 if args.no_wait else args.timeout
    body = {'title': title, 'markdown': markdown, 'actions': actions, 'input': {} if args.input else None,
            'wait': wait}
    return Plan('POST', '/api/dialogs', body=body, timeout=_long_poll(wait))


