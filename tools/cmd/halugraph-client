            raise usage_error('status KEY --clear takes no TEXT', 'Use: %s status %s --clear' % (PROG, key))
        return Plan('DELETE', '/api/agent/status/' + _segment(key))
    if not args.text:
        raise usage_error('status needs TEXT (or --clear to remove the status)',
                          'Example: %s status build "Bundling the app…" --state busy --progress 0.5' % PROG)
    body = {'key': key, 'text': _words(args.text, 'TEXT')}
    _optional(body, 'state', args.state)
    _optional(body, 'progress', args.progress)
    return Plan('POST', '/api/agent/status', body=body)


def diagnostic_from_args(args):
    """Build one DiagnosticInput from the ``error`` command's flags."""
    diag = {'message': _words(args.message, 'MESSAGE')}
    _optional(diag, 'severity', args.severity)
    _optional(diag, 'code', args.code or None)
    _optional(diag, 'graph', args.graph or None)
    _optional(diag, 'node', args.node or None)
    if args.port:
        port = {'side': args.side or 'input'}
        match = re.match(r'^#([0-9]+)$', args.port)
        if match:
            port['index'] = int(match.group(1))
        else:
            port['name'] = args.port
        diag['port'] = port
    _optional(diag, 'nodeType', args.node_type or None)
    _optional(diag, 'file', args.file or None)
    _optional(diag, 'line', args.line)
    _optional(diag, 'compileId', args.compile or None)
    return diag


def plan_error(args):
