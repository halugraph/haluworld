class _Exit(Exception):
    """Raised instead of SystemExit when argparse is done (--help, --version)."""

    def __init__(self, code):
        Exception.__init__(self, code)
        self.code = code


class _Parser(argparse.ArgumentParser):
    """ArgumentParser that reports usage errors as ClientError (exit 1, JSON on stderr), writes help to
    its own ``out`` stream (never by swapping the global sys.stdout) and never calls sys.exit."""

    def __init__(self, *args, **kwargs):
        self.out = kwargs.pop('out', None)
        argparse.ArgumentParser.__init__(self, *args, **kwargs)

    def print_help(self, file=None):
        argparse.ArgumentParser.print_help(self, file or self.out)

    def exit(self, status=0, message=None):
        if message:
            (self.out or sys.stderr).write(message)
        raise _Exit(status)

    def error(self, message):
        raise ClientError(EXIT_USAGE, message, '%s  (run `%s --help` for details)'
                          % (' '.join(self.format_usage().split()), self.prog))


class _VersionAction(argparse.Action):
    def __init__(self, option_strings, dest=argparse.SUPPRESS, default=argparse.SUPPRESS, help=None):
        argparse.Action.__init__(self, option_strings, dest=dest, default=default, nargs=0, help=help)

    def __call__(self, parser, namespace, values, option_string=None):
        (parser.out or sys.stdout).write('halugraph-client %s\n' % CLIENT_VERSION)
        raise _Exit(EXIT_OK)


class _Formatter(argparse.RawDescriptionHelpFormatter):
    def __init__(self, prog):
        argparse.RawDescriptionHelpFormatter.__init__(self, prog, max_help_position=30)


