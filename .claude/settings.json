{
  "enabledMcpjsonServers": ["halugraph"],
  "env": {
    "CLAUDE_CODE_MCP_AUTO_BACKGROUND_MS": "0"
  },
  "permissions": {
    "allow": [
      "mcp__halugraph",
      "Bash(tools/cmd/halugraph-client *)",
      "Bash(./tools/cmd/halugraph-client *)",
      "Bash(python3 tools/cmd/halugraph-client *)",
      "Bash(python tools/cmd/halugraph-client *)",
      "PowerShell(tools/cmd/halugraph-client *)",
      "PowerShell(tools\\cmd\\halugraph-client *)",
      "PowerShell(tools\\cmd\\halugraph-client.cmd *)",
      "PowerShell(.\\tools\\cmd\\halugraph-client.cmd *)",
      "Bash(npm install)",
      "Bash(npm install *)",
      "Bash(npm ci)",
      "Bash(npm ci *)",
      "Bash(npm run *)",
      "Bash(npm exec *)",
      "Bash(npx vite *)",
      "Bash(node *)",
      "Bash(cd *)",
      "Bash(mkdir *)",
      "Bash(cp *)",
      "Bash(rsync *)",
      "Bash(diff *)",
      "Bash(ls)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(wc *)",
      "Bash(find *)",
      "Bash(grep *)",
      "Bash(tee *)",
      "Bash(test *)",
      "Bash(pwd)",
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff)",
      "Bash(git diff *)",
      "Bash(git log)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Read(agents/**)",
      "Edit(agents/**)",
      "Write(agents/**)",
      "Read(process/**)",
      "Read(tools/**)",
      "Read(graphs/**)",
      "Edit(graphs/**)",
      "Write(graphs/**)",
      "Read(nodes/**)",
      "Edit(nodes/**)",
      "Write(nodes/**)",
      "Read(assets/**)"
    ],
    "deny": [
      "Edit(agents/compiles/*/input/**)",
      "Edit(agents/compiles/*/compile.json)",
      "Edit(assets/**)"
    ]
  }
}
