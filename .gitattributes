# Line endings (halugraph, spec §10): every text file of this project is LF — in git AND in the working
# tree, on every platform, also on Windows with core.autocrlf=true — so halugraph, the agent's tools and
# git always see the same bytes, and a commit never rewrites every line.
* text=auto eol=lf

# cmd.exe needs CRLF in batch files (tools/cmd/halugraph-client.cmd). Any letter case: git matches patterns
# case-sensitively on Linux / macOS but not on Windows, so SETUP.BAT would otherwise differ between them.
*.[cC][mM][dD] text eol=crlf
*.[bB][aA][tT] text eol=crlf

# Attachments are content-addressed (the file name starts with a hash of the bytes): never convert them,
# whatever their type — a converted line ending would no longer match the name (spec §12).
assets/** binary
assets/README.md text eol=lf
agents/compiles/*/input/assets/** binary
agents/compiles/*/app/public/assets/** binary

# Binary files anywhere else: never converted, never diffed or merged as text.
